# À définir dans Netlify > Site configuration > Environment variables (jamais dans le code, jamais dans Git)

# --- Supabase (obligatoire) : Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clé publique (anon) : visible par l'app, c'est normal
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clé SECRÈTE : uniquement pour les fonctions serveur

# --- Général
SITE_URL=https://ton-site.netlify.app   # sert aux liens de désabonnement et à la signature du webhook Twilio
UNSUB_SECRET=une-longue-phrase-secrete-au-hasard
DEFAULT_TZ=America/Toronto              # Paris : Europe/Paris
SEND_HOUR_START=10                      # heures d'envoi (heure locale du barbier)
SEND_HOUR_END=19
MAX_SENDS_PER_RUN=40                    # plafond par barbier et par passage horaire

# --- SMS réels (optionnel) : Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...      # ou, à la place : TWILIO_FROM=+15145550000

# --- Emails réels (optionnel) : Resend
RESEND_API_KEY=re_...
EMAIL_FROM=relance@ton-domaine.com      # domaine vérifié chez Resend
